# Python
__pycache__/
*.pyc

# Sistema / editores
.DS_Store
Thumbs.db
*.swp

# Segredos: nunca versionar
.env
.env.*
!.env.example

# Traduções bíblicas com direitos autorais (ACF, AA, NVI...): nunca versionar o texto completo.
# Ver ATTRIBUTION.md. Citações curtas usadas nos vídeos ficam em data/verses.json (direito de citação).
**/source/text/

# Intermediários pesados de render: vão para o GitHub Release "film-intermediates" (ver HANDOFF.md)
estudos/*/renders/.film/*
!estudos/*/renders/.film/narr.json
!estudos/*/renders/.film/keys.json
!estudos/*/renders/.film/render.log
estudos/*/renders/.stills/
# Vídeo 6: camadas de luz geradas por tools/layers.py e as imagens brutas (as usadas estão em motion/public/img)
estudos/biblia-at-no-nt/motion/public/layers/
estudos/biblia-at-no-nt/source/img/

# Site
node_modules/
estudos/*/motion/node_modules
site/dist/
site/.astro/
site/.vercel/
.vercel/

# Cópias de trabalho temporárias de agentes do Claude Code (git worktree): nunca versionar
.claude/worktrees/

# Capturas da revisão de design (impeccable): evidência local, regeneradas a cada revisão
.impeccable/review/
