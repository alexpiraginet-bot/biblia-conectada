{
  "name": "@biblia-conectada/church-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "migrate": "tsx src/cli.ts migrate",
    "seed:demo": "tsx src/cli.ts seed",
    "check": "npm run typecheck && npm test && npm run build",
    "setup": "tsx src/cli.ts setup"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.14",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
