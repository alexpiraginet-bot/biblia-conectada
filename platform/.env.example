# Development defaults: local persistent PGlite, loopback only. No cloud connection.
NODE_ENV=development
HOST=127.0.0.1
PORT=4318
DB_ENGINE=pglite
PGLITE_DIR=.local/database
DEMO_SEED=false
SESSION_TTL_HOURS=8
# Production requires pg, separate migration credentials and an unprivileged
# runtime login with NOINHERIT; do not use an owner/superuser/BYPASSRLS connection.
# DATABASE_URL=
# MIGRATION_DATABASE_URL=
# PUBLIC_ORIGIN=https://api.example.invalid
